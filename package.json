{
  "name": "wseth-wallet",
  "version": "1.3.0",
  "private": true,
  "description": "Android test wallet for Sepolia ETH and Wrapped Study Ether (WSETH).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync-contract": "node scripts/sync-contract.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "6.0.1",
    "@capacitor/android": "6.2.2",
    "@capacitor/clipboard": "6.0.3",
    "@capacitor/core": "6.2.2",
    "ethers": "6.17.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@types/qrcode": "^1.5.5",
    "typescript": "5.7.3",
    "vite": "5.4.14"
  }
}
